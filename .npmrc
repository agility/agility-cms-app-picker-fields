# The Agility app SDK still declares React 18 peers; this app runs React 19.
# The SDK is a postMessage wrapper with no React-version-sensitive code.
legacy-peer-deps=true

# A global ~/.npmrc on Agility machines points the whole @fortawesome scope at the
# Pro registry (npm.fontawesome.com), which 401s for the free package. Pin the
# scope back to the public registry so `fontawesome-free` installs for everyone.
@fortawesome:registry=https://registry.npmjs.org/
